# 构建输出
/build/
/build-linux/
/build-mingw/
/build-dbg/

# 游戏资源（从 Minecraft 提取，按 Mojang EULA 不随仓库分发）
# 例外：font/ 是 OFL 授权的开源字体烘焙产物，必须入库，否则 CI 出的包没有菜单字体。
/assets/*
!/assets/font/
!/assets/font/**

# 根目录的测试截图
/*.png
/*.txt

# 编译产物
*.o
*.obj
*.exe
*.a
*.lib
*.dll
# ANGLE 运行库是 BSD-3-Clause，随包分发，必须入库。
!/third_party/angle/**/*.dll

# 编辑器 / IDE 配置
.vscode/
.idea/
.vs/
*.suo
*.user
*.swp
*.sln
*.vcxproj
*.vcxproj.filters
.workbuddy/

# CMake 用户配置
CMakeUserPresets.json

# 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log

# 本地打包产物
/releases/
/perf_artifacts/

# CI 生成 Release 正文用的临时文件
/release_notes.md
